@page
@model Nomade.Pages.CvModel
@{
    ViewData["Title"] = "CV - Emanuel Infante";
    ViewData["BodyClass"] = "contenedor-full contenedor";
}

<main class="cv-main">
    <header class="cv-header">
        <div>
            <a asp-page="/Index"><h1 class="cv-color-pri cv-h1">Emanuel Infante</h1></a>
            <p class="cv-p">Desarrollador .NET | C# | ASP.NET | SQL Server</p>
            <div class="cv-centrar">
                <span class="cv-color-g">Argentina</span>
                <span class="cv-color-pri cv-gap-l cv-gap-r">|</span>
                <span class="cv-color-g">Disponible para trabajo junior</span>
            </div>
        </div>
    </header>

    <section class="cv-espaciado">
        <div>
            <span class="cv-badge">C#</span>
            <span class="cv-badge">ASP.NET Core</span>
            <span class="cv-badge">SQL Server</span>
            <span class="cv-badge">Entity Framework</span>
            <span class="cv-badge">HTML</span>
            <span class="cv-badge">CSS</span>
            <span class="cv-badge">JavaScript</span>
        </div>
    </section>

    <section class="cv-espaciado">
        <div>
            <h2 class="cv-h2 cv-upper-text">Proyecto destacado</h2>
            <div class="cv-card">
                <h3 class="cv-h3">Sistema de Gestión de Clientes (CAPATUR)</h3>
                <p class="cv-p cv-color-g">Desarrollador Full Stack</p>
                <p class="cv-p cv-color-g">Aplicación web desarrollada para digitalizar la gestión de clientes en un entorno real.</p>
                
                <ul class="cv-color-w">
                    <li><span class="cv-color-pri cv-gap-r">—</span>Desarrollo con ASP.NET Core y Entity Framework</li>
                    <li><span class="cv-color-pri cv-gap-r">—</span>Implementación de autenticación con Identity</li>
                    <li><span class="cv-color-pri cv-gap-r">—</span>CRUD completo de clientes</li>
                    <li><span class="cv-color-pri cv-gap-r">—</span>Persistencia de datos con SQL Server</li>
                </ul>
                
                <a class="cv-button" href="https://github.com/ipEmanuel/ProyectoCRUD" target="_blank" rel="noopener noreferrer">
                    Ver proyecto
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link w-4 h-4" aria-hidden="true">
                        <path d="M15 3h6v6"></path>
                        <path d="M10 14 21 3"></path>
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <section class="cv-espaciado">
        <div>
            <h2 class="cv-upper-text cv-h2">Experiencia</h2>
        </div>
        <div>
            <div class="cv-horizontal">
                <h3 class="cv-h3">Desarrollador Full Stack</h3>
                <span class="cv-color-g">2024 - Actualidad</span>
            </div>
            <p class="cv-p cv-color-g">Proyectos</p>
            <ul class="cv-color-w">
                <li><span class="cv-color-pri cv-gap-r">—</span>Desarrollo de aplicaciones web con C# y ASP.NET</li>
                <li><span class="cv-color-pri cv-gap-r">—</span>Implementación de bases de datos relacionales</li>
                <li><span class="cv-color-pri cv-gap-r">—</span>Diseño y desarrollo de interfaces web responsive</li>
                <li><span class="cv-color-pri cv-gap-r">—</span>Gestión completa de proyectos desde cero</li>
            </ul>
        </div>
    </section>

    <section class="cv-espaciado">
        <div>
            <h2 class="cv-upper-text cv-espaciado cv-h2">Habilidades</h2>
            <div>
                <div class="cv-color-w">
                    <div class="cv-habilidades">
                        <div class="col">
                            <div>
                                <span class="cv-color-pri">Lenguajes: </span>
                                <span>C#, JavaScript</span>
                            </div>
                            <div>
                                <span class="cv-color-pri">Bases de datos: </span>
                                <span>SQL Server</span>
                            </div>
                            <div>
                                <span class="cv-color-pri">Otros: </span>
                                <span>MVC, CRUD, Autenticación, Diseño Responsive</span>
                            </div>
                        </div>
                        <div class="col">
                            <div>
                                <span class="cv-color-pri">Frameworks: </span>
                                <span>ASP.NET Core, Entity Framework</span>
                            </div>
                            <div>
                                <span class="cv-color-pri">Frontend: </span>
                                <span>HTML, CSS</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="cv-espaciado cv-color-w">
        <h2 class="cv-upper-text cv-h2">Educación</h2>

        <div>
            <div>
                <span class="cv-educacion">Tecnicatura en Programación</span><span class="cv-color-g"> — UTN En curso</span>
            </div>

            <div class="cv-espaciado2">
                <span class="cv-educacion">Técnico Superior en Análisis y Desarrollo de Sistemas</span>
                <span class="cv-color-g"> — CENT 40</span>
            </div>
        </div>

        <div>
            <p class="cv-color-g cv-p">Cursos complementarios:</p>
            <span class="cv-badge-g">Desarrollo Web Full Stack - Udemy</span>
            <span class="cv-badge-g">C# Nivel 1 y 2 - Maxiprograma</span>
            <span class="cv-badge-g">UX/UI Design - Espacio UX</span>
        </div>
    </section>
</main>

