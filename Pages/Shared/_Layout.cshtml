<!DOCTYPE html>
<html lang="es" class="@ViewData["HtmlClass"]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nomade</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/normalize.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body class="@ViewData["BodyClass"]">
  
    @RenderBody()
   
    <footer class="cv-footer slide3">
        @* <a href="#top"><img src="~/img/icon-whale.png" alt=""></a> *@

        <partial name="_SocialNav" />
        <p>Emanuel © 2025</p>
    </footer>

    <script src="~/js/particles.min.js"></script>
    <script src="~/js/app.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
